APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pousada
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail ---------------------------------------------------------------
# Local (Mailpit no Sail)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailtrap (envio real em produção)
#MAIL_MAILER=mailtrap
#MAIL_TIMEOUT=10
# API HTTP do Mailtrap (SDK, usada pela newsletter)
#MAILTRAP_HOST=send.api.mailtrap.io
# SMTP do Mailtrap (formulários e demais e-mails)
#MAILTRAP_SMTP_HOST=live.smtp.mailtrap.io
#MAILTRAP_PORT=587
#MAILTRAP_USERNAME=api
#MAILTRAP_PASSWORD=
#MAILTRAP_ENCRYPTION=tls
#MAILTRAP_API_KEY=
# Destinatário das mensagens do site (vazio = e-mail das configurações)
#MAIL_CONTACT_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_PASS=

# Mercado Pago (site web)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=

# PagBank (app Flutter)
PAGBANK_SANDBOX=true
PAGBANK_TOKEN=
PAGBANK_CLIENT_ID=
PAGBANK_CLIENT_SECRET=
PAGBANK_WEBHOOK_URL=